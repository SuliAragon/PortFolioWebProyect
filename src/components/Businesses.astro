---
import '../styles/businesses.css';
import '../styles/business-directions.css';
import Booking from './BusinessBooking.astro';
import { withBase } from '../lib/paths.mjs';
interface Props { slug: string }
const { slug } = Astro.props;
const photo = (name:string) => withBase(`images/business/${name}.jpg`, import.meta.env.BASE_URL);
---
<div class={`business business-${slug}`} data-business={slug}>
{slug === 'sobremesa' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">sobremesa<span>CAFÉ & CONVERSACIÓN</span></a><a href="#carta">La carta</a><a href="#visita">Ven a vernos ↗</a></nav>
  <header class="diner-hero"><div class="diner-sign"><span>CAFÉ DE BARRIO / CÁDIZ</span><h1>Café para<br/>quedarte.</h1><p>Una buena taza. Una mesa libre.<br/>Ninguna prisa por recoger.</p><a class="biz-button" href="#carta">Pídete algo rico <span>↗</span></a></div><div class="diner-cup" aria-hidden="true"><svg viewBox="0 0 320 300" fill="none"><ellipse cx="150" cy="253" rx="114" ry="19" fill="#ec8b6f"/><path d="M58 99H231L215 222Q148 260 75 222Z" fill="#fff7e7" stroke="#713527" stroke-width="5"/><path d="M232 121C300 99 307 211 223 202" stroke="#713527" stroke-width="18"/><ellipse cx="144" cy="100" rx="86" ry="23" fill="#6e392d" stroke="#713527" stroke-width="5"/><path d="M117 67C87 43 139 35 118 9M156 65C130 45 178 28 157 6M193 68C167 47 211 36 194 15" stroke="#713527" stroke-width="5" stroke-linecap="round"/><path d="M115 161Q143 188 174 159" stroke="#713527" stroke-width="5" stroke-linecap="round"/></svg><span>BUENOS DÍAS<br/>TODO EL DÍA ☼</span></div><img class="diner-snapshot" src={photo('cafe')} alt="Interior de nuestra cafetería conceptual" fetchpriority="high"/><div class="diner-bottom"><span>01 / CAFÉ DE ESPECIALIDAD</span><span>02 / DESAYUNOS SIN RELOJ</span><span>03 / SOBREMESA INFINITA</span></div></header>
  <section class="coffee-menu biz-section" id="carta"><div><span class="biz-kicker">ALGO RICO PARA CADA MOMENTO</span><h2>Buenos días.<br/><em>Y buenas tardes.</em></h2></div><div data-filter-root><div class="biz-tabs" role="group" aria-label="Categoría de la carta"><button data-filter="cafe" aria-pressed="true">Cafés</button><button data-filter="desayuno" aria-pressed="false">Desayunos</button><button data-filter="dulce" aria-pressed="false">Algo dulce</button></div><div data-category="cafe"><p class="price-line"><span>Espresso<small>Corto, intenso, con carácter.</small></span><b>1,80 €</b></p><p class="price-line"><span>Flat white<small>Doble espresso y leche sedosa.</small></span><b>3,20 €</b></p><p class="price-line"><span>Filtro del día<small>Pregunta por el origen que estamos preparando.</small></span><b>3,50 €</b></p></div><div data-category="desayuno" hidden><p class="price-line"><span>Tostada de la casa<small>Tomate rallado, AOVE y pan de masa madre.</small></span><b>4,50 €</b></p><p class="price-line"><span>Bol de yogur<small>Fruta de temporada y granola casera.</small></span><b>5,50 €</b></p></div><div data-category="dulce" hidden><p class="price-line"><span>Bizcocho de limón<small>Un trocito de nuestra merienda favorita.</small></span><b>3,20 €</b></p><p class="price-line"><span>Cookie de chocolate<small>Crujiente por fuera, tierna por dentro.</small></span><b>2,80 €</b></p></div></div></section>
  <section class="coffee-visit" id="visita"><span>UNA MESA TE ESPERA</span><h2>Pasa. Siéntate.<br/>Quédate un rato.</h2><div><p>Lunes a viernes · 08:00—19:00<br/>Sábado y domingo · 09:00—14:00</p><p>Un café de barrio imaginado en Cádiz.<br/>Sin reservas. Con sitio para una buena charla.</p></div></section>
</>}
{slug === 'savia' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">savia.</a><span>HAIR STUDIO / CUIDADO CON RAÍZ</span><a href="#reserva">Tu próxima cita ↗</a></nav>
  <header class="salon-cover"><img src={photo('salon')} alt="Un corte trabajado en un salón de peluquería" fetchpriority="high"/><div class="salon-cover-top"><span>PERSONAL HAIR STUDIO</span><span>VOL. 01 / CÁDIZ</span></div><h1>UN CORTE.<br/>OTRA ACTITUD.</h1><div class="salon-cover-bottom"><p>Corte, color y cuidado.<br/>Tu identidad empieza por escucharte.</p><a href="#reserva">RESERVA TU MOMENTO ↗</a><span>SAVIA STUDIO — EST. 2026</span></div></header>
  <section class="salon-services biz-section" id="servicios"><span class="biz-kicker">MENOS TENDENCIAS. MÁS TÚ.</span><h2>Un cambio.<br/><em>O volver a reconocerte.</em></h2><div class="salon-service-grid">{[['01','Corte & forma','Un corte pensado para cómo se mueve tu pelo y cómo vives tú.','Desde 28 €'],['02','Color con intención','Matices, reflejos y luz. Siempre con diagnóstico previo.','Desde 55 €'],['03','Pausa & cuidado','Un ritual de hidratación, masaje y tiempo para desconectar.','Desde 25 €']].map(([n,t,d,p])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p><strong>{p}</strong></article>)}</div></section>
  <Booking title="Un ratito para ti." options={['Corte & forma — desde 28 €','Color con intención — desde 55 €','Pausa & cuidado — desde 25 €']} />
</>}
{slug === 'kilometro' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">km<span>KILÓMETRO / ESTACIÓN DE SERVICIO</span></a><span>EN TU CAMINO. A CUALQUIER HORA.</span><a href="#repostaje">Calcula tu parada ↘</a></nav>
  <header class="station-hub"><div class="station-hub-title"><span class="station-symbol" aria-hidden="true">↗</span><div><span>ESTACIÓN KM 024 / ÁREA DE SERVICIO</span><h1>Lo que necesitas.<br/>Antes de seguir.</h1></div><a href="#repostaje">Calcula tu repostaje ↓</a></div><div class="station-board"><div class="station-board-intro"><span>LA PRÓXIMA PARADA</span><strong>24<br/><small>HORAS A TU LADO</small></strong><p>Un café, una recarga y otra vez en camino.</p></div><a href="#repostaje"><span>01 / COMBUSTIBLE</span><strong>95</strong><span>1,589 €/l · precio demo ↗</span></a><a href="#servicios"><span>02 / MOVILIDAD ELÉCTRICA</span><strong>ϟ</strong><span>Recarga & café ↗</span></a><a href="#servicios"><span>03 / A PUNTO</span><strong>◉</strong><span>Lavado & aire ↗</span></a></div><div class="station-wayfinding"><span>← DESCANSO</span><span>TIENDA & CAFÉ ↑</span><span>REPOSTAJE →</span></div></header>
  <section class="fuel-calculator biz-section" id="repostaje"><div><span class="biz-kicker">SIN SORPRESAS EN EL SURTIDOR</span><h2>Tu repostaje,<br/>en números.</h2><p>Una estimación antes de arrancar.<br/>Tarifas de ejemplo, sin conexión a precios reales.</p></div><form data-fuel><label>Combustible<select name="fuel"><option value="1.589">Gasolina 95 · 1,589 €/l</option><option value="1.489">Diésel · 1,489 €/l</option><option value="1.729">Gasolina 98 · 1,729 €/l</option></select></label><label>Litros<input name="litres" type="number" min="1" max="120" step="1" value="40" required /></label><span class="fuel-display-label">TOTAL ESTIMADO</span><output data-fuel-total aria-live="polite">63,56 €</output><button class="biz-button" type="submit">Calcular <span>↗</span></button></form></section>
  <div class="fuel-services" id="servicios">{[['↗','Repostaje 24 h','Autoservicio sencillo, a cualquier hora.'],['ϟ','Recarga eléctrica','Tiempo para un café mientras recargas.'],['◉','Lavado & aire','Un pequeño cuidado para seguir mejor.'],['☕','Tienda & café','Algo rico para continuar el viaje.']].map(([i,t,d])=><article><span>{i}</span><h2>{t}</h2><p>{d}</p></article>)}</div>
</>}
{slug === 'salitre' && <>
  <header class="sea-menu-front"><div class="sea-menu-title"><span>COCINA DE COSTA<br/>CÁDIZ / TEMPORADA 2026</span><h1>SALITRE</h1><span>DE LA LONJA<br/>A TU MESA</span></div><div class="sea-menu-center"><div class="sea-menu-note"><span>NUESTRA MESA ESTÁ SERVIDA</span><h2>Hoy sabe<br/>a mar.</h2><p>Una carta pequeña.<br/>Producto que cuenta de dónde viene.</p><a href="#carta">ABRIR LA CARTA ↓</a></div><img src={photo('restaurant')} alt="Una mesa de restaurante preparada para compartir" fetchpriority="high"/><div class="sea-menu-coordinates"><span>36° 31′ N</span><span>LA SOBREMESA TAMBIÉN ES UN PLATO</span><span>6° 17′ O</span></div></div><a class="sea-menu-book" href="#reserva">UNA MESA PARA TI <span>↗</span></a></header>
  <section class="restaurant-menu biz-section" id="carta"><div><span class="biz-kicker">PARA COMPARTIR. O NO.</span><h2>Lo que trae<br/><em>la marea.</em></h2><p>Una carta pequeña, un producto bien elegido.<br/>Consulta al equipo las opciones y los alérgenos.</p></div><div>{[['Tomate de temporada','Ventresca, encurtidos y aceite de la sierra.','14 €'],['Croquetas de pescado','Crujientes, cremosas, hechas en casa.','12 €'],['Arroz del litoral','Pescado de lonja y el fondo que lo cambia todo. Mínimo 2 personas.','24 €/p.'],['Pesca del día','A la brasa, con verduras y un toque de limón.','22 €'],['Final de limón','Crema de limón, merengue y crumble.','7 €']].map(([t,d,p])=><p class="price-line"><span>{t}<small>{d}</small></span><b>{p}</b></p>)}</div></section>
  <Booking title="Las mejores historias empiezan en una mesa." options={['Mesa para 2','Mesa para 3','Mesa para 4','Mesa para 6']} />
</>}
{slug === 'tallo' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">tallo<span>FLORES PARA LO QUE IMPORTA</span></a><a href="#ramos">Nuestros ramos</a><a href="#reserva">Elige tu detalle ↗</a></nav>
  <header class="flower-shop-front"><div class="flower-shop-title"><span>FLORES FRESCAS / GESTOS ENORMES</span><h1>Di más.<br/>Regala flores.</h1><a href="#ramos">Encuentra tu ramo ↗</a></div><div class="flower-shop-image"><img src={photo('flowers')} alt="Flores amarillas entre tallos verdes" fetchpriority="high"/><span class="flower-shop-label">SIN OCASIÓN<br/>TAMBIÉN VALE.</span></div><div class="flower-shop-petal" aria-hidden="true">✿</div><div class="flower-shop-strip"><span>DE TEMPORADA</span><span>COMPUESTO A MANO</span><span>PARA ESA PERSONA</span></div></header>
  <section class="flower-collection biz-section" id="ramos"><span class="biz-kicker">NINGÚN RAMO ES IGUAL A OTRO</span><h2>¿Qué quieres decir?</h2><div class="flower-choices flower-grid">{[['☼','Qué alegría','Amarillos, naranjas y toda la luz del día.','28 €'],['✿','Estoy aquí','Blancos suaves y verdes que abrazan.','32 €'],['♡','Porque sí','Rosas, tonos cálidos y cero explicaciones.','36 €']].map(([i,t,d,p])=><article><span>{i}</span><h3>{t}</h3><p>{d}</p><strong>{p}</strong><a href="#reserva">Elegir este ramo ↗</a></article>)}</div></section>
  <Booking title="Un detalle que florece." options={['Qué alegría — 28 €','Estoy aquí — 32 €','Porque sí — 36 €']} action="Preparar mi ramo"/>
</>}
{slug === 'radial' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">RADIAL®</a><span>TALLER DE BICICLETAS / SIN RODEOS</span><a href="#revision">Ponla a punto ↗</a></nav>
  <header class="mechanic-front"><div class="mechanic-index"><span>RADIAL / SERVICIO TÉCNICO</span><strong>R—01</strong><span>MANTENIMIENTO<br/>SIN RODEOS</span></div><div class="mechanic-main"><div><span>DIAGNÓSTICO → AJUSTE → CARRETERA</span><h1>Tu bici.<br/>Como debe ir.</h1><p>Ese cambio que salta. Ese freno que roza.<br/>Lo escuchamos. Lo dejamos fino.</p><a href="#revision">CONSULTAR REVISIONES ↗</a></div><img src={photo('bike')} alt="Bicicleta de carretera de perfil para un estudio de mantenimiento" fetchpriority="high"/><div class="mechanic-measures"><span>TRANSMISIÓN ✓</span><span>FRENADA ✓</span><span>RODADURA ✓</span></div></div></header>
  <section class="bike-plans biz-section" id="revision"><span class="biz-kicker">CUADRO DE SERVICIOS / MANO DE OBRA INCLUIDA</span><h2>Ficha de mantenimiento.<br/>Elige tu intervención.</h2><div class="bike-plan-grid">{[['01','Ajuste urbano','Frenos, cambios y presión. Para volver a tu rutina.','29 €'],['02','Revisión completa','Transmisión, ruedas, dirección y chequeo general.','59 €'],['03','Servicio a fondo','Desmontaje, limpieza y ajuste completo de componentes.','99 €']].map(([n,t,d,p])=><article><span>INTERVENCIÓN {n}</span><h3>{t}</h3><p>{d}</p><strong>{p}</strong><a href="#reserva">SOLICITAR ESTE SERVICIO ↗</a></article>)}</div><p class="biz-fine">Recambios y trabajos adicionales se presupuestan aparte.</p></section>
  <Booking title="El siguiente trayecto empieza aquí." options={['Ajuste urbano — 29 €','Revisión completa — 59 €','Servicio a fondo — 99 €']} />
</>}
{slug === 'casa-calma' && <>
  <nav class="biz-nav"><a href="#habitaciones">La casa</a><a class="biz-brand" href="#">casa calma<span>SMALL HOTEL / SLOW DAYS</span></a><a href="#estancia">Tu estancia ↗</a></nav>
  <header class="hotel-postcard"><img src={photo('hotel')} alt="Una habitación cálida abierta al descanso" fetchpriority="high"/><div class="hotel-postcard-top"><span>UNA CASA. OTRA VELOCIDAD.</span><span>CÁDIZ / 36° N</span></div><div class="hotel-postcard-title"><span>POSTAL Nº 01</span><h1>Fuera<br/>del reloj.</h1><p>Una cama, la luz de la mañana<br/>y el lujo de no tener planes.</p><a href="#estancia">IMAGINA TU ESTANCIA ↗</a></div><span class="hotel-postcard-bottom">CASA CALMA — HABITACIONES PARA BAJAR EL VOLUMEN</span></header>
  <section class="hotel-stay biz-section" id="estancia"><div><span class="biz-kicker">IMAGINA TUS DÍAS AQUÍ</span><h2>Tu próxima pausa.</h2><p>Calcula una estancia orientativa.<br/>Desayuno incluido. Tarifas de demostración.</p></div><form data-stay><label>Habitación<select name="room"><option value="95">Patio · 95 €/noche</option><option value="125">Luz · 125 €/noche</option><option value="155">Terraza · 155 €/noche</option></select></label><label>Llegada<input type="date" name="arrival" required data-future-date /></label><label>Salida<input type="date" name="departure" required data-future-date /></label><button type="submit" class="biz-button">Calcular estancia <span>↗</span></button><p role="status" data-stay-result>Elige tus fechas. Esta demo no reserva habitaciones.</p></form></section>
  <section class="hotel-intro biz-section" id="habitaciones"><span class="biz-kicker">MENOS HABITACIONES. MÁS CUIDADO.</span><h2>El lujo<br/><em>de lo sencillo.</em></h2><div><p>Una casa pensada para bajar el volumen. Texturas naturales, rincones para leer y una cama de la que cuesta despedirse.</p><dl><div><dt>Patio</dt><dd>Desde 95 €/noche</dd></div><div><dt>Luz</dt><dd>Desde 125 €/noche</dd></div><div><dt>Terraza</dt><dd>Desde 155 €/noche</dd></div></dl></div></section>
</>}
{slug === 'compania' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">compañía<span>CLÍNICA VETERINARIA</span></a><a href="#cuidados">Cómo cuidamos</a><a class="vet-nav-cta" href="#reserva">Preparar visita ↗</a></nav>
  <header class="clinic-front"><div class="clinic-intro"><span class="clinic-cross" aria-hidden="true">✚</span><span>CLÍNICA VETERINARIA / CERCA DE VOSOTROS</span><h1>Su mejor vida<br/>empieza con<br/>buenos cuidados.</h1><p>Prevención, revisiones y un equipo que conoce su nombre.</p><a class="biz-button" href="#reserva">Preparar su próxima visita ↗</a></div><div class="clinic-dog"><img src={photo('dog')} alt="Un golden retriever con una flor" fetchpriority="high"/><span>HOLA, FAMILIA. ♡</span></div><div class="clinic-paths"><a href="#cuidados"><span>01</span>Es su primera visita <b>↗</b></a><a href="#cuidados"><span>02</span>Quiero un seguimiento <b>↗</b></a><a href="#reserva"><span>03</span>Necesito organizar una cita <b>↗</b></a></div></header>
  <section class="vet-care biz-section" id="cuidados"><span class="biz-kicker">EN CADA ETAPA, A SU LADO</span><h2>Su bienestar tiene<br/>muchas formas.</h2><div class="vet-care-grid">{[['01','Primeros pasos','Revisiones de cachorro, orientación y prevención.'],['02','Siempre en forma','Chequeos, seguimiento y atención general.'],['03','Años compartidos','Acompañamiento y cuidados de animales sénior.']].map(([n,t,d])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div><details><summary>¿Cómo preparo la primera visita?</summary><p>Trae su cartilla sanitaria y la información sobre tratamientos anteriores. Anota tus dudas para comentarlas durante la consulta.</p></details><details><summary>¿Esta web atiende urgencias?</summary><p>Este es un concepto de portfolio, sin atención clínica real. Si tu animal necesita atención urgente, contacta con tu centro veterinario habitual.</p></details></section>
  <Booking title="Cuéntanos quién viene a vernos." options={['Primera visita · perro','Primera visita · gato','Revisión de seguimiento','Consulta de cuidados sénior']} />
</>}
{slug === 'bloque' && <>
  <nav class="biz-nav"><a class="biz-brand" href="#">BLOQUE<span>FUERZA / MOVIMIENTO / COMUNIDAD</span></a><a href="#horarios">Horarios</a><a href="#reserva">Ven a probar ↗</a></nav>
  <header class="gym-hero"><div><span class="biz-kicker">TU PUNTO DE PARTIDA ES SUFICIENTE</span><h1>HAZTE<br/><span>FUERTE.</span></h1><p>A tu ritmo. Con tu gente.<br/>El entrenamiento empieza donde estás.</p><a class="biz-button" href="#reserva">Prepara tu primera sesión <span>↗</span></a></div><img src={photo('gym')} alt="Espacio de entrenamiento con pesas y equipamiento de fuerza" fetchpriority="high"/><span class="gym-sticker">SIN POSTUREO.<br/>CON PROPÓSITO.</span></header>
  <div class="gym-strip"><span>ENTRENA BIEN</span><b>✳</b><span>DESCANSA MEJOR</span><b>✳</b><span>REPITE</span></div>
  <section class="gym-schedule biz-section" id="horarios"><div><span class="biz-kicker">UN HUECO PARA TI</span><h2>TU SEMANA.<br/>TU BLOQUE.</h2></div><div data-filter-root><div class="biz-tabs" role="group" aria-label="Día de entrenamiento"><button data-filter="lunes" aria-pressed="true">Lunes</button><button data-filter="miercoles" aria-pressed="false">Miércoles</button><button data-filter="viernes" aria-pressed="false">Viernes</button></div>{[['lunes','07:30','Fuerza base','18:00','Movilidad','19:00','Functional'],['miercoles','08:00','Functional','18:30','Fuerza base','20:00','Movilidad'],['viernes','07:30','Movilidad','17:00','Fuerza base','18:00','Equipo']].map(([day,...sessions])=><div data-category={day} hidden={day!=='lunes'}>{[0,2,4].map(i=><p class="gym-session"><span>{sessions[i]}</span><strong>{sessions[i+1]}</strong><span>50 MIN</span></p>)}</div>)}</div></section>
  <Booking title="El primer paso cuenta." options={['Sesión de prueba · Fuerza base','Sesión de prueba · Functional','Sesión de prueba · Movilidad']} />
</>}
{slug === 'la-huerta' && <>
  <div class="market-announcement">DE LA TIERRA A TU MESA / EL SABOR NO NECESITA VIAJAR TANTO</div><nav class="biz-nav"><a href="#cesta">Lo de esta semana</a><a class="biz-brand" href="#">la huerta<span>FRUTA, VERDURA Y VECINDAD</span></a><a href="#cesta">Haz tu cesta ↓</a></nav>
  <header class="grocery-front"><div class="grocery-headline"><span>EL MERCADO DE TU BARRIO, EN TU PANTALLA</span><h1>Esta semana,<br/>la tierra manda.</h1><p>Compra por temporada. Cocina por ganas.</p></div><div class="grocery-feature"><img src={photo('market')} alt="Un mercado repleto de verduras de temporada" fetchpriority="high"/><div class="grocery-ticket"><span>LA CESTA DE HOY</span><strong>Fresco.<br/>Cerca.<br/>Y sin líos.</strong><a href="#cesta">LLENA TU CESTA ↓</a><span>FRUTA / VERDURA / VECINDAD</span></div></div><div class="grocery-service"><span>✓ ELIGE LA CANTIDAD</span><span>✓ REVISA EL TOTAL</span><span>✓ COMPRA DE EJEMPLO</span></div></header>
  <section class="market-basket biz-section" id="cesta"><header><span class="biz-kicker">LA COMPRA EMPIEZA POR LO QUE TE APETECE</span><h2>Tu cesta.<br/><em>A tu gusto.</em></h2><p>Añade productos y calcula tu compra de ejemplo.</p></header><div class="market-products produce-list">{[['Tomate de ensalada','1 kg','3.2','●'],['Mandarinas','1 kg','2.4','☼'],['Calabaza','1 pieza','3.8','◒'],['Espinacas','1 manojo','1.9','❧']].map(([name,unit,price,symbol])=><article><span class="produce-symbol">{symbol}</span><h3>{name}</h3><small>{unit}</small><div><b>{Number(price).toFixed(2).replace('.',',')} €</b><button data-basket-add data-name={name} data-price={price} aria-label={`Añadir ${name}`}>＋</button></div></article>)}</div><aside class="market-total basket-receipt"><div><span>TU CESTA</span><p data-basket-items role="status">Todavía hay sitio para algo rico.</p></div><output data-basket-total aria-live="polite">0,00 €</output><button data-basket-clear>Vaciar cesta</button></aside><p class="biz-fine">Compra de demostración. No se realizan pedidos ni pagos.</p></section>
</>}
<footer class="biz-footer"><span>UN NEGOCIO IMAGINADO.<br/>UNA WEB CON IDENTIDAD.</span><p>Concepto de portfolio de Jesús Aragón.<br/>Marcas, servicios, horarios y precios de demostración.</p><a href="#">Volver arriba ↑</a></footer>
</div>
<script>import '../scripts/businesses';</script>
