---
import Scene from './Scene.astro';
import { planets } from '../data/solar.mjs';
interface Props { slug: string }
const { slug } = Astro.props;
---
{slug === 'pelago' && <>
  <section class="ocean-hero ocean-retreat"><Scene kind="ocean" label="Mar tridimensional de olas azules y luz de amanecer sobre el horizonte"/><nav class="concept-nav"><a class="wordmark" href="#">pélago<span>®</span></a><span>UN LUGAR AL QUE VOLVER</span></nav><div class="ocean-title"><span class="eyebrow">NO TIENES QUE ESTAR EN NINGUNA OTRA PARTE.</span><h1><em>Respira.</em></h1><p>El resto puede esperar.</p></div><div class="retreat-time"><span>INHALA</span><i></i><span>EXHALA</span></div><div class="ocean-bottom"><span>ATLÁNTICO<br/>36° 31′ N — 6° 17′ O</span><a class="circle-link" href="#horizontes" aria-label="Continuar junto al mar">↓</a><p>Sin agenda.<br/>Sin prisa.</p></div><div class="ocean-control"><label for="tide">RITMO DEL MAR</label><input type="range" id="tide" data-scene-range min="0.2" max="2" step="0.1" value="0.7" aria-label="Intensidad de las olas"/><button data-motion class="motion-button" aria-pressed="false" aria-label="Pausar animación">Ⅱ</button></div></section>
  <section class="retreat-letter" id="horizontes"><span class="eyebrow">UNA NOTA DESDE LA ORILLA</span><p>Nos enseñaron a llenar los días.<br/>Aquí venimos a <em>dejarlos abiertos.</em></p><div><span>Un paseo sin destino.<br/>Una conversación que se alarga.<br/>La sal, todavía en la piel.</span><span>El verdadero viaje empieza<br/>cuando dejas de contar<br/>lo que te queda por hacer.</span></div><span class="retreat-signature">Nos vemos en el azul.</span></section>
</>}
{slug === 'forma' && <>
  <section class="architecture-sheet"><nav class="concept-nav"><a class="wordmark" href="#">forma<span>®</span></a><span>ESTUDIO DE ARQUITECTURA</span><a href="#estudio">Manifiesto ↗</a></nav><div class="drawing-title"><span>PROYECTO 001<br/>ESTUDIO VOLUMÉTRICO</span><h1>Una casa.<br/><em>Muchas formas de vivir.</em></h1></div><div class="drawing-stage"><span class="drawing-axis axis-top">A ───────────────────────────────────────── A′</span><span class="drawing-axis axis-side">SECCIÓN / LUZ / ESPACIO</span><Scene kind="architecture" label="Maqueta de una vivienda escalonada sobre una lámina de arquitectura, con patios, pórticos y luz lateral"/><div class="drawing-note"><span>CASA PATIO</span><p>La vida sucede<br/>entre los muros.</p><span>VOLUMEN ABIERTO · Nº 001</span></div><div class="drawing-compass">N<br/>↑</div><button data-motion class="motion-button" aria-pressed="false" aria-label="Pausar animación">Ⅱ</button></div><div class="drawing-spec"><span>01 / VIVIENDA</span><span>02 / PATIOS</span><span>03 / MATERIA NATURAL</span><span>ESTUDIO CONCEPTUAL ↗</span></div></section>
  <section class="architecture-manifesto" id="estudio"><span class="section-tag">NUESTRA FORMA DE MIRAR</span><div><p><sup>01</sup> Escuchar el lugar.</p><p><sup>02</sup> Restar con intención.</p><p><sup>03</sup> Dejar entrar la vida.</p></div><span>La orientación, la sombra, los materiales.<br/>Diseñamos lo que permanece cuando sobra todo lo demás.</span></section>
</>}
{slug === 'orbita' && <>
  <section class="solar-observatory">
    <nav class="concept-nav"><a class="wordmark" href="#">◉ ÓRBITA</a><span>ATLAS DEL SISTEMA SOLAR</span><span class="solar-live"><i></i> SIMULACIÓN EN MOVIMIENTO</span></nav>
    <div class="solar-heading"><div><span class="eyebrow">UNA ESTRELLA. OCHO MUNDOS.</span><h1>Nuestro pequeño<br/><em>universo.</em></h1></div><p>Todo se mueve.<br/>Acércate a lo que te despierta curiosidad.</p></div>
    <div class="solar-stage"><Scene kind="space" label="Sistema solar interactivo con el Sol, ocho planetas, órbitas, el cinturón de asteroides y los anillos de Saturno"/><div class="solar-reticle" aria-hidden="true"><span>+</span><span>+</span><span>+</span><span>+</span></div><div class="solar-panel" aria-live="polite"><span id="planet-type">EL CENTRO DE TODO</span><h2 id="planet-name">El Sol</h2><p id="planet-description">Una estrella, ocho planetas y un viaje que no se detiene. Selecciona un mundo para acercarte.</p><button data-planet="-1" class="solar-reset" aria-pressed="true">↗ Ver sistema completo</button></div><div class="solar-controls"><label for="orbit-speed">VELOCIDAD ORBITAL</label><input type="range" id="orbit-speed" data-scene-range min="0.1" max="2" step="0.1" value="0.5"/><button data-motion class="motion-button" aria-pressed="false" aria-label="Pausar animación">Ⅱ</button></div><span class="solar-scale">EXPLORACIÓN ARTÍSTICA · TAMAÑOS Y DISTANCIAS NO A ESCALA</span></div>
    <div class="planet-dock" role="group" aria-label="Explorar los planetas">{planets.map((planet,i)=><button data-planet={i} aria-pressed="false" style={`--planet-color:${planet.color}`}><span class="planet-icon" class:list={{'has-ring':planet.rings}}></span><span><small>0{i+1}</small>{planet.name}</span></button>)}</div>
  </section>
</>}
{slug === 'pulso' && <>
  <section class="music-hero"><nav class="concept-nav"><a class="wordmark" href="#">PULSO<span>✳</span></a><a href="#frecuencia">ENTRA EN FRECUENCIA ↘</a></nav><div class="music-meta"><span>CULTURA ELECTRÓNICA<br/>SIN PUNTO FINAL.</span><span>EDICIÓN<br/>IMAGINARIA / 01</span></div><h1>NO LO PIENSES.<br/><span>SIÉNTELO.</span></h1><Scene kind="music" label="Anillos de una onda sonora de color lima que vibran a distinta intensidad"/><div class="music-foot"><span>CUERPO. SONIDO. COMUNIDAD.</span><a href="#frecuencia" class="music-enter" aria-label="Ir al sintetizador">↘</a></div></section>
  <div class="music-marquee" aria-hidden="true">SIN ETIQUETAS ✳ SIN LÍMITES ✳ SOLO PULSO ✳ SIN ETIQUETAS ✳ SIN LÍMITES ✳</div>
  <section class="music-studio section-pad" id="frecuencia"><div><span class="eyebrow">TU FRECUENCIA, TUS REGLAS</span><h2>Haz que<br/>algo <em>vibre.</em></h2><p>Activa el sonido y encuentra tu pulso.<br/>Auriculares, si quieres desaparecer un rato.</p></div><div class="synth-panel"><div class="synth-header"><span>OSCILADOR / 01</span><span class="live-dot"></span></div><div class="frequency-number"><output id="frequency-value">110</output><span>Hz</span></div><label for="frequency">FRECUENCIA</label><input id="frequency" type="range" min="55" max="440" value="110" step="1"/><button class="button button-lime" id="audio-toggle" aria-pressed="false">Activar sonido <span>↗</span></button><p id="audio-status" aria-live="polite">El sonido empieza solo cuando tú lo activas.</p></div></section>
</>}
{slug === 'bruma' && <>
  <section class="perfume-editorial"><nav class="concept-nav"><a class="wordmark" href="#">bruma.</a><span>OBJETOS PARA LA MEMORIA</span><a href="#notas">Las notas ↓</a></nav><div class="perfume-spread"><div class="perfume-vertical"><span>ÉTUDE OLFACTIVE / 01</span><h1>Lo invisible<br/><em>permanece.</em></h1><p>No es lo que llevas.<br/>Es lo que dejas.</p></div><div class="perfume-product"><Scene kind="perfume" label="Frasco de perfume escultórico, presentado como una pieza de una editorial de moda"/><span class="perfume-page-number">01 — 03</span></div><div class="perfume-marginal"><span>EAU DE MÉMOIRE<br/>50 ML</span><div class="scent-options" role="group" aria-label="Elegir fragancia"><button data-scent="0" data-variant="0" class="is-selected" aria-pressed="true"><i style="background:#ad87bb"></i><span>01<br/>La hora azul</span></button><button data-scent="1" data-variant="1" aria-pressed="false"><i style="background:#dbab75"></i><span>02<br/>Sol de invierno</span></button><button data-scent="2" data-variant="2" aria-pressed="false"><i style="background:#7c9c80"></i><span>03<br/>Después de llover</span></button></div><button data-motion class="motion-button" aria-pressed="false" aria-label="Pausar animación">Ⅱ</button></div></div></section>
  <section class="perfume-index" id="notas"><div class="scent-notes" aria-live="polite"><span id="scent-number">Nº 01</span><h2 id="scent-name">La hora azul</h2><p id="scent-description">La quietud de una tarde que se vuelve noche. Suave, íntima, imposible de retener.</p><dl><div><dt>01 / SALIDA</dt><dd id="scent-top">Bergamota · Hojas de violeta</dd></div><div><dt>02 / CORAZÓN</dt><dd id="scent-heart">Iris · Té blanco</dd></div><div><dt>03 / FONDO</dt><dd id="scent-base">Almizcle · Madera de cedro</dd></div></dl></div></section>
</>}
{slug === 'umbral' && <>
  <section class="art-hero"><nav class="concept-nav"><a class="wordmark" href="#">UMBRAL_</a><span>ESPACIO PARA LO INESPERADO</span></nav><h1>NADA<br/>PERMANECE<br/><span>QUIETO.</span></h1><Scene kind="art" label="Escultura metálica abstracta que cambia de forma al seleccionar una obra"/><div class="art-stamp">ARTE<br/>EN ESTADO<br/>DE CAMBIO <span>↗</span></div><div class="art-hero-bottom"><span>EXPOSICIÓN DIGITAL<br/>ABIERTA A OTRAS MIRADAS</span><a href="#obras" aria-label="Explorar las obras">↓</a><span>NO TOCAR.<br/>O MEJOR, SÍ.</span></div></section>
  <section class="art-works section-pad" id="obras"><div class="section-tag">ÍNDICE DE OBRAS / 001 — 003</div><h2>La forma es<br/>solo el principio.</h2><div class="art-work-list" role="group" aria-label="Seleccionar obra"><button data-variant="0" aria-pressed="true" class="is-selected"><span>001</span><strong>Tensión continua</strong><span>ESCULTURA DIGITAL</span><span>↗</span></button><button data-variant="1" aria-pressed="false"><span>002</span><strong>Materia inestable</strong><span>ESTUDIO GENERATIVO</span><span>↗</span></button><button data-variant="2" aria-pressed="false"><span>003</span><strong>Equilibrio imposible</strong><span>FORMA EXPERIMENTAL</span><span>↗</span></button></div><p>Selecciona una obra y <a href="#">vuelve a la sala ↑</a> para observar cómo cambia la escultura.</p></section>
</>}
{slug === 'miga' && <>
  <section class="bakery-window"><nav class="concept-nav"><a class="wordmark" href="#">miga<span>✳</span></a><span>EL OBRADOR DE TODOS LOS DÍAS</span><a href="#obrador">Pasa, estás en casa ↘</a></nav><div class="bakery-heading"><span class="eyebrow">AGUA, HARINA Y CERO ATAJOS.</span><h1>Hoy hay <em>pan.</em></h1><span class="bakery-handwriting">Y mañana, también.</span></div><div class="bakery-counter"><Scene kind="bread" label="Mostrador con tres panes artesanos tridimensionales: hogaza de masa madre, pieza trenzada y barra rústica"/><span class="bakery-seal">HECHO<br/>DESPACIO<br/>✳</span></div><div class="bakery-labels"><span><small>01 / EL DE SIEMPRE</small>La hogaza.</span><span><small>02 / EL DE COMPARTIR</small>El trenzado.</span><span><small>03 / EL DEL CAMINO</small>La barra.</span></div></section><div class="bread-strip"><span>LA CORTEZA CRUJE</span><span>✳</span><span>LA CASA SE LLENA</span><span>✳</span><span>EL TIEMPO SE AMASA</span></div>
  <section class="bakery-recipe" id="obrador"><span class="eyebrow">RECETA PARA UN DÍA MEJOR</span><h2>Un poco de harina.<br/>Un montón de <em>paciencia.</em></h2><div class="recipe-line"><span>01</span><h3>Una masa viva.</h3><p>Un cultivo que cuidamos cada día. El principio de todas las buenas historias del obrador.</p></div><div class="recipe-line"><span>02</span><h3>48 horas sin prisa.</h3><p>La fermentación hace lo suyo. Nosotros aprendemos a esperar.</p></div><div class="recipe-line"><span>03</span><h3>Una mesa compartida.</h3><p>Al final, todo esto era para eso. Para partir el pan y quedarse un rato más.</p></div><p class="recipe-signature">Con las manos. Con cariño. — miga</p></section>
</>}
{slug === 'cota' && <>
  <section class="mountain-expedition"><Scene kind="mountain" label="Paisaje alpino con una cordillera de cumbres angulosas nevadas, bosques y un lago entre valles"/><nav class="concept-nav"><a class="wordmark" href="#">△ COTA</a><span>CUADERNO DE EXPEDICIÓN / 001</span><a href="#rutas">Elegir ruta ↗</a></nav><div class="expedition-heading"><span class="eyebrow">EL SILENCIO TIENE OTRA ALTURA</span><h1>Más allá<br/>del <em>ruido.</em></h1></div><div class="expedition-caption"><span>45° N / 07° E<br/>PAISAJE ALPINO IMAGINADO</span><p>A veces, encontrar el camino<br/>es dejarlo todo atrás.</p><a class="circle-link" href="#rutas" aria-label="Descubrir las expediciones">↓</a></div><div class="altitude-mark"><span>COTA DE INSPIRACIÓN</span><strong>3.842<span>m</span></strong><span>RESPIRA. ESTÁS AQUÍ.</span></div></section>
  <section class="expedition-log" id="rutas"><div class="expedition-log-title"><span>EL CUADERNO<br/>DE CAMPO</span><h2>Tres maneras<br/><em>de perderse bien.</em></h2><span>01 — 03<br/>RUTAS IMAGINADAS</span></div><div class="route-picker" role="group" aria-label="Elegir ruta"><button data-route="0" data-variant="0" class="is-selected" aria-pressed="true"><span>01 / EL VALLE</span><strong>Donde el agua<br/>se queda.<small>Lago, bosque y primera luz</small></strong><span>↗</span></button><button data-route="1" data-variant="1" aria-pressed="false"><span>02 / LA CRESTA</span><strong>El último<br/>rayo de sol.<small>Piedra cálida y horizontes abiertos</small></strong><span>↗</span></button><button data-route="2" data-variant="2" aria-pressed="false"><span>03 / LA CUMBRE</span><strong>Por encima<br/>de las nubes.<small>Azul frío y nieve en las cimas</small></strong><span>↗</span></button></div><div class="expedition-foot"><p aria-live="polite" id="route-description">El valle tranquilo: un lago entre bosques, roca y cumbres nevadas. La escala la pone el paisaje.</p><a class="text-link" href="#">Volver al paisaje ↑</a></div></section>
</>}
{slug === 'nexo' && <>
  <section class="nexo-workspace"><nav class="concept-nav"><a class="wordmark" href="#">nexo<span>✳</span></a><span>ESPACIO DE CONEXIONES</span><span class="nexo-local">● DEMO LOCAL</span></nav><div class="workspace-title"><span class="eyebrow">ABRE UNA NUEVA PERSPECTIVA</span><h1>Las ideas no viven solas.</h1><p>Elige un contexto. Encuentra lo que conecta las piezas.</p></div><div class="workspace-toolbar" role="group" aria-label="Ejemplo de análisis"><span>EXPLORAR</span><button class="is-selected" data-insight="0" data-variant="0" aria-pressed="true">Producto</button><button data-insight="1" data-variant="1" aria-pressed="false">Equipo</button><button data-insight="2" data-variant="2" aria-pressed="false">Contenido</button><span>⌘ / CONTEXTO</span></div><div class="connection-workbench"><div class="workspace-sources"><span>ENTRADAS / 03</span><div id="insight-sources" class="ai-sources"><span>Comentarios de usuarios</span><span>Uso de funcionalidades</span><span>Solicitudes de soporte</span></div><span class="workspace-flow">→</span></div><div class="workspace-network"><Scene kind="ai" label="Red tridimensional de conexiones que cambia de color según el contexto seleccionado"/><span>NÚCLEO DE CONTEXTO</span></div><div class="workspace-result" aria-live="polite"><span>UNA CONEXIÓN POSIBLE</span><h2 id="insight-title">La fricción también es una señal.</h2><p id="insight-description">Cruzar preguntas de soporte con funciones poco utilizadas ayuda a encontrar qué parte de la experiencia necesita más claridad.</p><span class="connection-status">✓ CONTEXTO RELACIONADO</span></div></div><div class="workspace-status"><span><i></i> TODO SUCEDE EN TU NAVEGADOR</span><span>3 FUENTES → 1 PERSPECTIVA</span><button data-motion aria-pressed="false">Pausar animación Ⅱ</button></div><p class="workspace-disclaimer">Una exploración de interfaz. Los ejemplos están predefinidos; no se envían datos ni se conecta con un modelo de IA.</p></section>
</>}
{slug === 'terminal' && <>
  <section class="terminal-shell" data-terminal-root data-base={import.meta.env.BASE_URL} data-theme="green">
    <nav class="terminal-nav"><a href="#" class="terminal-mark">J/A_OS</a><span>SESIÓN PÚBLICA · SANDBOX LOCAL</span><span class="terminal-online"><i></i> ONLINE</span></nav>
    <div class="terminal-heading"><span>INTERFAZ DE LÍNEA DE COMANDOS / 11</span><h1>Escribe algo.<br/><em>El sistema responde.</em></h1></div>
    <Scene kind="terminal" label="Núcleo tridimensional de datos formado por módulos, conexiones y una retícula que reacciona a cada comando"/>
    <div class="terminal-window" data-terminal-window>
      <div class="terminal-window-bar"><span><i></i><i></i><i></i></span><strong>visitor@jesus-aragon — zsh — 80×24</strong><span>⌘ K</span></div>
      <div class="terminal-output" id="terminal-output" role="log" aria-live="polite" aria-label="Salida del terminal">
        <p class="terminal-line terminal-muted">J/A_OS 1.2.0 · sesión segura iniciada</p>
        <p class="terminal-line">Escribe <strong>help</strong> para descubrir el sistema.</p>
        <p class="terminal-line terminal-muted">Pista: prueba “whoami”, “projects” o “open orbita”.</p>
      </div>
      <form class="terminal-form" data-terminal-form>
        <label for="terminal-command"><span>visitor@portfolio</span>:~$</label>
        <input id="terminal-command" data-terminal-input autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="terminal-shortcuts" />
        <span class="terminal-cursor" aria-hidden="true"></span>
      </form>
    </div>
    <div class="terminal-shortcuts" id="terminal-shortcuts"><span>↑↓ HISTORIAL</span><span>TAB AUTOCOMPLETAR</span><span>CTRL+L LIMPIAR</span></div>
    <div class="terminal-quick" aria-label="Comandos rápidos"><button data-terminal-command="help">help</button><button data-terminal-command="whoami">whoami</button><button data-terminal-command="projects">projects</button><button data-terminal-command="theme amber">theme amber</button></div>
    <p class="terminal-note">Simulación local: interpreta comandos del portfolio y nunca accede al sistema de tu equipo.</p>
  </section>
</>}
{slug === 'crudo' && <>
  <section class="brutal-lab" data-brutal-lab data-mode="structure">
    <div class="brutal-ticker" aria-hidden="true"><span>IDEAS SIN PLANCHAR</span><b>✦</b><span>ESTRUCTURA A LA VISTA</span><b>✦</b><span>PROBAR / ROMPER / AJUSTAR</span><b>✦</b></div>
    <div class="brutal-meta"><span>DOCUMENTO<br/><strong>Taller CRUDO / Nº 01</strong></span><span>ESTADO<br/><strong>Funcionando. A propósito.</strong></span><span>HECHO EN<br/><strong>Cádiz · 2026</strong></span></div>
    <div class="brutal-hero">
      <div class="brutal-copy"><span>NO ES UNA AGENCIA. ES UNA MESA DE TRABAJO.</span><h1>PRIMERO<br/><mark>FUNCIONA.</mark><br/>LUEGO<br/><i>HABLAMOS.</i></h1></div>
      <div class="brutal-machine"><Scene kind="brutal" label="Prototipo tridimensional de vigas, paneles, tornillos y piezas separadas que deja visible su estructura"/><span class="brutal-asterisk" aria-hidden="true">✱</span><span class="brutal-machine-label">PROTOTIPO / EN VIVO</span></div>
    </div>
    <div class="brutal-console">
      <div><span>MODO DE PRUEBA</span><strong id="brutal-verb">MOSTRAR LAS COSTURAS</strong><p id="brutal-note" aria-live="polite">Cada unión queda visible. Si algo sostiene la idea, merece ocupar espacio.</p></div>
      <div class="brutal-modes" role="group" aria-label="Cambiar el prototipo"><button class="is-selected" data-brutal-mode="0" data-variant="0" aria-pressed="true"><small>01</small>ESTRUCTURA</button><button data-brutal-mode="1" data-variant="1" aria-pressed="false"><small>02</small>EXPLOSIÓN</button><button data-brutal-mode="2" data-variant="2" aria-pressed="false"><small>03</small>TENSIÓN</button></div>
    </div>
  </section>
  <section class="brutal-rules" id="reglas"><header><span>NOTAS DE TALLER / 001—003</span><h2>Una idea no necesita<br/>pedir perdón.</h2></header><div class="brutal-rule"><span>001 / MATERIAL</span><h3>Deja la huella.</h3><p>Las marcas del proceso cuentan cómo se construyó. Borrarlas también es una decisión.</p></div><div class="brutal-rule"><span>002 / RITMO</span><h3>Rompe donde importa.</h3><p>La cuadrícula ordena la conversación. La idea decide cuándo salirse de ella.</p></div><div class="brutal-rule"><span>003 / ENTREGA</span><h3>Ponlo a prueba.</h3><p>Un prototipo que se puede tocar explica más que una promesa perfectamente alineada.</p></div></section>
</>}
{slug !== 'pelago' && slug !== 'forma' && slug !== 'orbita' && slug !== 'bruma' && slug !== 'nexo' && slug !== 'terminal' && slug !== 'crudo' && <div class="concept-motion"><button data-motion aria-pressed="false">Pausar animación Ⅱ</button></div>}
<div class="concept-credit"><span>UNA EXPLORACIÓN DE JESÚS ARAGÓN</span><span>Marca y contenido conceptuales · Portfolio</span><a href="#">Volver arriba ↑</a></div>
