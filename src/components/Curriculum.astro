---
import Scene from './Scene.astro';
import { withBase } from '../lib/paths.mjs';
const pdf = withBase('cv-jesus-aragon.pdf', import.meta.env.BASE_URL);
const skills = [
  ['Frontend', 'React', 'TypeScript', 'JavaScript', 'Angular', 'HTML · CSS · SCSS', 'Tailwind CSS'],
  ['Backend', 'Java · Spring Boot', 'Python', 'PHP', 'APIs REST', 'JWT'],
  ['Datos', 'PostgreSQL', 'MySQL', 'H2', 'Looker Studio', 'Análisis de datos'],
  ['Herramientas', 'Docker', 'Git · GitHub · GitLab', 'Postman · Swagger', 'Maven · Gradle', 'CI/CD básico'],
];
---
<div class="cv-top"><span>DESARROLLADOR DE APLICACIONES</span><a href="mailto:j.aragonmonzon@gmail.com">Hablemos <span>↗</span></a></div>
<section class="cv-hero">
  <div class="cv-copy"><div class="eyebrow"><span class="small-cross">✳</span> CÓDIGO CON INTENCIÓN</div><h1>Jesús<br/>Aragón<span class="orange">.</span></h1><p class="cv-role">Conecto ideas, código<br/>y experiencias.</p><p class="cv-description">Desarrollo aplicaciones que hacen sencilla la complejidad. Del frontend al backend, con una mirada cada vez más puesta en los datos.</p><div class="button-row"><a class="button button-dark" href="#experiencia">Conoce mi trayectoria <span>↘</span></a><a class="text-link" href={pdf} download>Descargar CV <span>↓</span></a></div></div>
  <div class="cv-art"><div class="art-coordinate">36.5297° N<br/>6.2924° O</div><Scene kind="cv" label="Escultura naranja de bandas entrelazadas que gira lentamente y responde al puntero"/><div class="art-caption"><span class="small-cross">✳</span><span>ENTRE LA LÓGICA<br/>Y LA CREATIVIDAD</span><span class="art-edition">FIG. 01</span></div><button class="motion-button" data-motion aria-pressed="false" aria-label="Pausar animación">Ⅱ</button></div>
</section>
<div class="cv-ticker"><span>CÁDIZ, ESPAÑA <span>↗</span></span><span>FRONTEND + BACKEND + DATOS</span><span>CONSTRUIR. APRENDER. EVOLUCIONAR.</span></div>
<section class="cv-about section-pad" id="sobre-mi"><div class="section-tag">01 / SOBRE MÍ</div><div><h2>La tecnología tiene sentido<br/>cuando <em>sirve a las personas.</em></h2><p>Soy Jesús Aragón Monzón, Técnico Superior en Desarrollo de Aplicaciones Multiplataforma. Me gusta convertir necesidades reales en aplicaciones claras, robustas y mantenibles.</p><p>He trabajado en interfaces, servicios y visualización de datos. Aporto capacidad de adaptación, responsabilidad y una forma de trabajar cercana: escuchar, colaborar y seguir aprendiendo.</p><div class="achievement-row"><div><span>✳</span><strong>Matrícula de Honor</strong><small>Grado Superior en DAM</small></div><div><span>↗</span><strong>Innovación premiada</strong><small>Proyecto de fin de grado</small></div></div></div></section>
<section class="cv-experience section-pad" id="experiencia"><div class="section-heading"><div class="section-tag">02 / EXPERIENCIA</div><h2>Aprender haciendo.<br/><em>Crecer en equipo.</em></h2></div><article class="experience-row"><div class="experience-time">OCT. 2025 — ABR. 2026<span>Remoto · El Puerto de Santa María</span></div><div><div class="experience-title"><h3>ALTEN Spain</h3><span>PROYECTOS PARA AIRBUS ↗</span></div><p>Desarrollo de interfaces y visualización de datos en proyectos para Airbus, mediante herramientas internas en un entorno industrial. Información compleja, convertida en decisiones más claras.</p><ul><li>Creación y mantenimiento de dashboards en Looker Studio.</li><li>Nuevas funcionalidades y mejoras de usabilidad en aplicaciones internas.</li><li>Integración de APIs REST, preparación de datos y pruebas básicas de integración.</li></ul><div class="tags"><span>React</span><span>TypeScript</span><span>Looker Studio</span><span>APIs REST</span></div></div></article><article class="experience-row"><div class="experience-time">2025<span>Cádiz</span></div><div><div class="experience-title"><h3>Xebia</h3><span>DESARROLLO WEB ↗</span></div><p>Desarrollo de una plataforma de juegos de mesa conectada a BoardGameGeek y una aplicación de gestión de prensa digital con operaciones CRUD e interfaz responsive.</p><ul><li>API propia e integración con servicios externos.</li><li>Interfaces claras para consultar, filtrar y gestionar información.</li><li>Colaboración en equipo, documentación y mejora de procesos.</li></ul><div class="tags"><span>React</span><span>Spring Boot</span><span>PostgreSQL</span><span>Docker</span><span>JWT</span></div></div></article></section>
<section class="cv-skills section-pad" id="competencias"><div class="section-heading"><div class="section-tag">03 / HERRAMIENTAS</div><h2>Una idea puede empezar<br/><em>en cualquier capa.</em></h2></div><div class="skills-grid">{skills.map(([name, ...items], i) => <div><span class="skill-index">0{i + 1}</span><h3>{name}</h3><ul>{items.map(item => <li>{item}</li>)}</ul></div>)}</div><p class="other-skills">También: Android (Java / XML), Unity (C#), VS Code, IntelliJ IDEA y NetBeans.</p></section>
<section class="cv-education section-pad"><div class="section-tag">04 / FORMACIÓN</div><div><article><span>2025 — 2026</span><h3>Big Data e Inteligencia Artificial</h3><p>Especialización · IES Rafael Alberti, Cádiz</p></article><article><span>2023 — 2025</span><h3>Desarrollo de Aplicaciones Multiplataforma</h3><p>Grado Superior · Staff Formación, Cádiz</p></article><div class="education-extras"><div><h4>Idiomas</h4><p>Español · Nativo<br/>Inglés · Intermedio B1<br/>Lengua de Signos Española</p></div><div><h4>Formación complementaria</h4><p>Prevención de riesgos laborales<br/>Monitor de actividades y tiempo libre<br/>Manipulación de alimentos · LSE</p></div></div></div></section>
<section class="cv-contact section-pad" id="contacto"><span class="eyebrow">EL SIGUIENTE PASO</span><h2>Tu próxima idea.<br/><em>La construimos.</em></h2><a href="mailto:j.aragonmonzon@gmail.com">j.aragonmonzon@gmail.com <span>↗</span></a><div><span>Cádiz, España</span><a href={pdf} download>Currículum completo ↓</a></div></section>
