---
import Nav from './Nav.astro';
import End from './End.astro';
import Flash from './Flash.astro';
import {withBase} from '../../lib/paths.mjs';
const image=withBase('images/extended/tattoo.jpg',import.meta.env.BASE_URL);
const flashes=[['Rosa de los días','Lía','Botánico'],['Norte propio','Bruno','Geométrico'],['Trazo libre','Noa','Abstracto'],['Mirada abierta','Bruno','Geométrico'],['Cordillera','Noa','Abstracto'],['A pulso','Lía','Botánico']];
---
<Nav name="AGUJA" label="TATTOO ATELIER / CÁDIZ" links={[["#flash","El archivo"],["#artistas","Artistas"],["#idea","Tu idea"]]}/>
<header class="ink-hero"><div><span class="ex-label">NO TODAS LAS HISTORIAS SE ESCRIBEN EN PAPEL.</span><h1>A FLOR<br/>DE <i>PIEL.</i></h1><p>Una línea, una memoria, un comienzo.<br/>Tatuajes de autor para llevar lo tuyo contigo.</p><a class="ex-button" href="#flash">Abre el archivo <span>↘</span></a></div><figure><img src={image} alt="Espalda con un tatuaje de gran formato en blanco y negro" fetchpriority="high"/><figcaption>TRAZO PROPIO / ESTUDIO ABIERTO A IDEAS</figcaption></figure><span class="ink-stamp">PIEZAS<br/>CON<br/>HISTORIA ✳</span></header>
<div class="ex-ribbon">DIBUJAR · ESCUCHAR · CREAR · VOLVER A DIBUJAR ·</div>
<section class="ex-section" id="flash"><div class="ex-section-head"><div><span class="ex-label">ARCHIVO 001—006</span><h2>El principio<br/>de <em>algo tuyo.</em></h2></div><p>Seis bocetos originales para esta colección. Filtra por artista y elige una pieza como punto de partida.</p></div><div class="ex-filters" role="group" aria-label="Filtrar por artista">{['Todos','Lía','Bruno','Noa'].map((name,i)=><button data-artist={name} aria-pressed={i===0?'true':'false'}>{name}</button>)}</div><div class="flash-grid">{flashes.map(([title,artist,style],i)=><article data-flash-artist={artist}><div class="flash-art"><Flash index={i}/><span>AG / 00{i+1}</span></div><div><span>{style} / {artist}</span><h3>{title}</h3><button data-flash-pick={title}>Partir de este diseño ↗</button></div></article>)}</div></section>
<section class="ink-artists ex-section" id="artistas"><span class="ex-label">TRES MANERAS DE MIRAR</span><h2>La mano detrás<br/>de la <em>línea.</em></h2><div class="ex-three">{[['Lía','BOTÁNICA & LÍNEA FINA','Encuentra formas en hojas, flores y pequeños gestos. Su trabajo empieza con una conversación y un cuaderno.'],['Bruno','GEOMETRÍA & BLACKWORK','Equilibrio, contraste y repetición. Diseños que acompañan la anatomía y dejan respirar la piel.'],['Noa','ABSTRACTO & GESTUAL','Trazos abiertos, movimiento y una mirada gráfica. Cada pieza conserva algo de su primer boceto.']].map(([name,style,text])=><article><span>{style}</span><h3>{name}</h3><p>{text}</p></article>)}</div></section>
<section class="ex-section ex-process"><span class="ex-label">SIN PRISA, CON CRITERIO</span><h2>De la primera idea<br/>al último trazo.</h2><ol>{[['01','Te escuchamos','Una referencia, una sensación o una historia. Encontramos juntos el enfoque.'],['02','Le damos forma','Definimos zona, tamaño, estilo y un presupuesto antes de avanzar.'],['03','Lo hacemos tuyo','Revisamos el diseño y sus proporciones contigo antes de la sesión.']].map(([n,t,d])=><li><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></li>)}</ol></section>
<section class="ink-idea ex-section" id="idea"><div><span class="ex-label">EL LIENZO EMPIEZA AQUÍ</span><h2>Tu historia.<br/>Nuestro siguiente<br/><em>boceto.</em></h2><p>No hace falta venir con todo resuelto. Preparar esta idea te ayudará a explicar lo que buscas.</p></div><form data-tattoo><label>Punto de partida<input name="design" placeholder="Una idea propia o un diseño del archivo" required maxlength="80"/></label><div class="ex-form-row"><label>Zona<select name="zone"><option>Brazo</option><option>Pierna</option><option>Espalda</option><option>Otra zona a consultar</option></select></label><label>Tamaño aproximado<select name="size"><option>Pequeño · hasta 8 cm</option><option>Mediano · 8 a 18 cm</option><option>Grande · más de 18 cm</option></select></label></div><label>Qué quieres contar<textarea name="story" rows="4" required minlength="10" maxlength="500" placeholder="Tu idea, referencias o lo que significa para ti…"></textarea></label><button class="ex-button" type="submit">Ver mi propuesta <span>↗</span></button><p data-tattoo-result role="status">El resumen se prepara aquí. No se envía al estudio.</p></form></section>
<End name="AGUJA" title="Una buena pieza empieza hablando." choices={['Diseño a medida','Consultar un flash','Conocer el proceso']} questions={[["¿Tengo que elegir un diseño del archivo?","No. El archivo es una forma de explorar estilos. La propuesta también puede empezar con una idea propia y desarrollarse desde cero."],["¿Se puede saber el precio antes de la sesión?","El planteamiento del estudio contempla revisar tamaño, zona y complejidad para preparar una propuesta. Esta web no ofrece presupuestos reales."],["¿Los artistas y diseños son reales?","El equipo es ficticio y los bocetos se han creado para esta web de portfolio. No existe una agenda de sesiones conectada."]]}/>
