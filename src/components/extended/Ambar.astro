---
import Nav from './Nav.astro';import End from './End.astro';import {questions} from '../../data/extended';import {withBase} from '../../lib/paths.mjs';
const photo=withBase('images/extended/drive.jpg',import.meta.env.BASE_URL);
---
<Nav name="ÁMBAR" label="AUTOESCUELA / DA EL SIGUIENTE PASO" links={[["#metodo","El método"],["#test","Ponte a prueba"],["#packs","Tu plan"]]}/>
<header class="driving-hero"><div><span class="ex-label">NO HACE FALTA TENERLO TODO CONTROLADO.</span><h1>EL SIGUIENTE<br/>PASO LO<br/><mark>CONDUCES TÚ.</mark></h1><p>Aprende desde cero, pregunta sin vergüenza y avanza con un plan que se adapta a ti.</p><a class="ex-button" href="#packs">Diseña tu salida <span>↗</span></a></div><div class="driving-visual"><img src={photo} alt="Interior de un vehículo con vistas a una carretera" fetchpriority="high"/><span class="learner-sign" aria-hidden="true">L</span><span>EMPEZAR TAMBIÉN ES AVANZAR.</span></div></header>
<div class="driving-strip"><span>TEORÍA CLARA</span><b>→</b><span>PRÁCTICA CON CALMA</span><b>→</b><span>CONFIANZA AL VOLANTE</span></div>
<section class="ex-section" id="metodo"><span class="ex-label">UN CAMINO, PASO A PASO</span><h2>Primero lo entiendes.<br/>Después lo conduces.</h2><div class="ex-three driving-steps">{[['01','Entender','Sesiones de teoría por bloques, ejemplos cotidianos y espacio para repasar lo que más cuesta.'],['02','Practicar','Una progresión de maniobras y recorridos pensada para ganar soltura sin saltarse pasos.'],['03','Preparar','Revisión de objetivos y orientación del equipo para llegar al siguiente hito con un plan claro.']].map(([n,t,d])=><article><b>{n}</b><h3>{t}</h3><p>{d}</p></article>)}</div></section>
<section class="ex-section driving-test" id="test"><div><span class="ex-label">TRES PREGUNTAS PARA ROMPER EL HIELO</span><h2>¿Arrancamos?</h2><p>Un ejercicio introductorio de hábitos de conducción. No es un examen oficial ni sustituye el temario de una autoescuela.</p><span class="test-score" data-test-score role="status">0 / 3 respondidas</span><button class="ex-text-button" data-test-reset>Empezar de nuevo ↻</button></div><div>{questions.map((q,index)=><fieldset data-question={index}><legend><span>0{index+1}</span>{q.question}</legend>{q.answers.map((answer,i)=><label><input type="radio" name={`question-${index}`} value={i}/><span>{answer}</span></label>)}<p data-answer-feedback role="status"></p></fieldset>)}</div></section>
<section class="ex-section driving-packs" id="packs"><div><span class="ex-label">UN PLAN QUE PUEDES ENTENDER</span><h2>Las cuentas,<br/><em>antes de empezar.</em></h2><p>Base de 149 € para la propuesta teórica y 32 € por práctica. Combina las sesiones para ver un total orientativo.</p><ul><li>Material teórico de ejemplo incluido en la base.</li><li>Prácticas individuales de 45 minutos.</li><li>Tasas, psicotécnico y derechos de examen no incluidos.</li></ul></div><form data-driving><label>Prácticas de 45 minutos <output data-lessons-label>10</output><input type="range" min="5" max="40" step="1" value="10" name="lessons" aria-label="Número de prácticas"/></label><dl><div><dt>Base teórica</dt><dd>149 €</dd></div><div><dt>Prácticas</dt><dd data-driving-practice>320 €</dd></div></dl><span class="ex-label">TOTAL DEL PLAN</span><output class="ex-big-price" data-driving-total aria-live="polite">469 €</output><p class="ex-note">Tarifa ficticia. El número de sesiones necesarias depende del aprendizaje individual.</p><button class="ex-button" type="submit">Revisar mi plan ↗</button><p data-driving-result role="status"></p></form></section>
<section class="ex-section driving-schedule"><span class="ex-label">EL APRENDIZAJE CABE EN TU SEMANA</span><h2>Un ritmo<br/>que puedas seguir.</h2><div class="ex-three"><article><h3>Mañanas</h3><p>Teoría · lunes y miércoles<br/>10:00—11:00</p></article><article><h3>Tardes</h3><p>Teoría · martes y jueves<br/>18:00—19:00</p></article><article><h3>A tu medida</h3><p>Las prácticas se organizarían con el equipo según tu disponibilidad.</p></article></div><p class="ex-note">Horario de muestra para este concepto de autoescuela.</p></section>
<End name="ÁMBAR" title="Tu primera pregunta ya es un paso." choices={['Permiso B desde cero','Retomar mi preparación','Consultar un plan de prácticas']} questions={[["¿Cuántas prácticas necesito?","El aprendizaje es individual. La calculadora permite explorar precios de ejemplo, no estimar cuándo estarías preparado para un examen."],["¿El mini test utiliza preguntas oficiales?","No. Son tres ejercicios propios sobre hábitos de seguridad. Para preparar un permiso debe utilizarse formación y material oficial vigente."],["¿Puedo matricularme desde aquí?","Esta autoescuela es ficticia. El formulario prepara un resumen local y no genera una matrícula ni transmite tus datos."]]}/>
