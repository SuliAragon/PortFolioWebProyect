---
import Nav from './Nav.astro';import End from './End.astro';import {books} from '../../data/extended';import {withBase} from '../../lib/paths.mjs';
const photo=withBase('images/extended/library.jpg',import.meta.env.BASE_URL);
---
<div class="book-masthead">LIBRERÍA INDEPENDIENTE / UN SITIO PARA QUEDARSE ENTRE LÍNEAS</div><Nav name="margen" label="LIBROS / ENCUENTROS / OTRAS VIDAS" links={[["#estanteria","La estantería"],["#lectura","Tu próxima lectura"],["#agenda","La agenda"]]}/>
<header class="gazette-front"><div class="gazette-date"><span>EL PERIÓDICO DE UNA LIBRERÍA</span><span>Nº 001 / CÁDIZ / NOVIEMBRE 2026</span></div><h1>Siempre cabe<br/>otra historia.</h1><div class="gazette-columns"><article class="gazette-lead"><span>LA LECTURA DE LA SEMANA</span><div class="gazette-book" aria-hidden="true"><small>MARGEN EDICIONES</small><strong>La otra<br/>orilla.</strong><span>CLARA DEL RÍO</span></div><h2>Hay libros que encuentran su momento.</h2><p>Una carta sin abrir. Una casa junto al agua. La primera recomendación de nuestra estantería.</p><a href="#estanteria">LEER LA RECOMENDACIÓN ↗</a></article><article class="gazette-story"><img src={photo} alt="Estanterías llenas de libros para descubrir" fetchpriority="high"/><span>VIDA DE LIBRERÍA</span><h2>Entra sin título.<br/>Sal con una historia.</h2><p>Se permite curiosear. Se agradecen las preguntas. Nos gusta que una recomendación acabe en una conversación.</p><a href="#lectura">ENCUENTRA TU PRÓXIMA LECTURA ↗</a></article><aside><span>LA AGENDA</span><strong>12<small>NOV</small></strong><p>LECTURAS<br/>COMPARTIDAS<br/>19:00</p><hr/><strong>21<small>NOV</small></strong><p>UNA MAÑANA<br/>DE CUENTOS<br/>11:30</p><a href="#agenda">TODOS LOS ENCUENTROS ↓</a></aside></div></header>
<section class="ex-section" id="estanteria"><div class="ex-section-head"><div><span class="ex-label">UNA ESTANTERÍA CON CRITERIO</span><h2>Pocos libros.<br/><em>Muchas puertas.</em></h2></div><p>Seis títulos y autores inventados para mostrar el catálogo. Selecciona un género o abre una ficha para leer la recomendación.</p></div><div class="ex-filters" role="group" aria-label="Género literario">{[['all','Todos'],['novela','Novela'],['ensayo','Ensayo'],['poesia','Poesía']].map(([value,label],i)=><button data-book-filter={value} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><div class="book-shelf">{books.map((book,i)=><article data-book-genre={book.genre}><div class="book-cover" style={`--cover:${book.color}`}><span>MARGEN EDICIONES / 0{i+1}</span><strong>{book.title}</strong><span class="cover-line" aria-hidden="true"></span><small>{book.author}</small></div><div><span class="ex-label">{book.genre}</span><h3>{book.title}</h3><p>{book.author} · {book.price.toFixed(2).replace('.',',')} €</p><details><summary>Por qué nos gusta</summary><p>{book.note}</p></details></div></article>)}</div></section>
<section class="ex-section book-match" id="lectura"><div><span class="ex-label">NO ES UN ALGORITMO MISTERIOSO. ES ESCUCHAR.</span><h2>Hoy, ¿qué te<br/>apetece <em>leer?</em></h2><p>Dos pistas bastan para empezar. Te propondremos una lectura del pequeño catálogo de esta demo.</p></div><form data-book-match><label>Busco…<select name="mood"><option value="calma">Un poco de calma</option><option value="curiosidad">Ideas que me despierten</option><option value="aventura">Una aventura que me atrape</option></select></label><label>Y me apetece…<select name="length"><option value="corta">Una lectura breve</option><option value="larga">Una historia para quedarme</option></select></label><button class="ex-button" type="submit">Recomiéndame un libro ↗</button><div class="book-match-result" data-book-result role="status">Tu próxima historia puede estar muy cerca.</div></form></section>
<section class="ex-section book-agenda" id="agenda"><span class="ex-label">LOS LIBROS TAMBIÉN SE CONVERSAN</span><h2>Nos vemos<br/><em>entre páginas.</em></h2><div class="ex-three">{[['12 NOV','Lecturas compartidas','19:00 / CLUB DE LECTURA','Trae un pasaje de un libro que quieras compartir. Una mesa abierta para hablar de lo que leemos.'],['21 NOV','Una mañana de cuentos','11:30 / LECTURA EN FAMILIA','Historias para escuchar juntos y descubrir el placer de que alguien lea en voz alta.'],['28 NOV','Escribir al margen','18:00 / TALLER DE ESCRITURA','Ejercicios breves para observar lo cotidiano y convertirlo en el comienzo de una historia.']].map(([date,t,time,d])=><article><span class="agenda-date">{date}</span><h3>{t}</h3><small>{time}</small><p>{d}</p><a class="ex-text-button" href="#contacto">Me interesa ↗</a></article>)}</div><p class="ex-note">Agenda ficticia de noviembre de 2026; no hay eventos reales asociados.</p></section>
<section class="ex-section book-letter"><span class="ex-label">UNA NOTA DE LA LIBRERÍA</span><p>Hay libros que llegan<br/>justo cuando hacen falta.<br/><em>Nos gusta ayudar a encontrarlos.</em></p><span>Con tiempo y con ganas. — margen</span></section>
<End name="margen" title="Siempre hay una recomendación pendiente." choices={['Encontrar una lectura','Consultar la agenda','Una selección para regalar']} questions={[["¿Se pueden comprar los títulos?","Los libros, autores y cubiertas de esta colección son ficticios y se han creado para el portfolio. No hay una tienda conectada."],["¿Cómo funciona la recomendación?","Relaciona tu ánimo y la longitud preferida con los seis libros del catálogo. Todo ocurre en el navegador y no se llama a una IA."],["¿Puedo apuntarme al club?","El formulario permite preparar una consulta de ejemplo. La agenda es ficticia y no genera inscripciones reales."]]}/>
