---
import Nav from './Nav.astro';import End from './End.astro';import {withBase} from '../../lib/paths.mjs';
const photo=withBase('images/extended/wedding.jpg',import.meta.env.BASE_URL);
const guests=['Alex','Dani','Cris','Mar','Leo','Noa','Sam','Vega','Nico','Luz'];
---
<Nav name="nudo" label="CELEBRACIONES CON SENTIDO" links={[["#celebrar","Vuestra forma"],["#programa","El día"],["#mesas","Las mesas"]]}/>
<header class="wedding-hero"><div><span class="ex-label">NO HAY DOS HISTORIAS IGUALES.</span><h1>Que se note<br/>que sois<br/><em>vosotros.</em></h1><p>Una celebración con lo que os importa.<br/>Gente querida, detalles con sentido y espacio para disfrutar.</p><a class="ex-button" href="#celebrar">Imaginemos vuestro día <span>↗</span></a></div><div class="wedding-photo"><img src={photo} alt="Ramo de flores y detalle de una celebración de boda" fetchpriority="high"/><span>Un día.<br/>Mil maneras<br/>de recordarlo.</span></div></header>
<section class="ex-section wedding-services" id="celebrar"><span class="ex-label">ACOMPAÑAR SIN OCUPAR VUESTRO LUGAR</span><h2>La forma de celebrarlo<br/>también cuenta <em>vuestra historia.</em></h2><div class="ex-three">{[['Desde el principio','Diseño de la celebración, búsqueda de espacios, calendario y coordinación de proveedores. Un proyecto compartido desde la primera conversación.'],['Los últimos detalles','Para quienes ya han avanzado y necesitan ordenar decisiones, revisar el plan y conectar todas las piezas.'],['El día de la boda','Un equipo pendiente del programa, los tiempos y los detalles para que vuestra única tarea sea vivirlo.']].map(([t,d],i)=><article><span>0{i+1} / ACOMPAÑAMIENTO</span><h3>{t}</h3><p>{d}</p></article>)}</div></section>
<section class="ex-section wedding-day" id="programa"><div><span class="ex-label">UN EJEMPLO DE CELEBRACIÓN</span><h2>El día pasa.<br/><em>Lo vivido queda.</em></h2><p>Así podría fluir una boda de tarde. Los horarios se adaptarían al lugar, a la estación y a vuestra manera de celebrar.</p></div><ol>{[['17:30','La bienvenida','Primeros abrazos, agua fresca y el reencuentro.'],['18:00','El sí','Una ceremonia que habla con vuestra voz.'],['19:00','La conversación','Aperitivo, música y tiempo para mezclarse.'],['20:30','La mesa','Una cena para compartir y brindar.'],['22:30','El baile','La primera canción de una noche por recordar.']].map(([time,t,d])=><li><time>{time}</time><div><h3>{t}</h3><p>{d}</p></div></li>)}</ol></section>
<section class="ex-section wedding-planner" id="mesas"><div class="ex-section-head"><div><span class="ex-label">UN PEQUEÑO ENSAYO ANTES DEL GRAN DÍA</span><h2>Cada persona,<br/><em>en su sitio.</em></h2></div><p>Arrastra los invitados a una mesa o usa el selector de cada tarjeta. Hay cuatro sitios por mesa; puedes cambiar de opinión las veces que quieras.</p></div><div class="seating-status"><p data-seat-status role="status">0 de 10 invitados colocados.</p><button class="ex-text-button" data-seat-reset>Volver a empezar ↻</button></div><div class="seating-board"><div class="guest-pool" data-table="pending"><header><span>POR COLOCAR</span><strong data-table-count="pending">10</strong></header><div data-table-guests="pending">{guests.map((guest,i)=><article class="guest-card" draggable="true" data-guest={`guest-${i}`}><strong>{guest}</strong><label><span class="sr-only">Mesa de {guest}</span><select data-guest-select={`guest-${i}`} aria-label={`Mesa de ${guest}`}><option value="pending">Por colocar</option><option value="olivo">Olivo</option><option value="mar">Mar</option><option value="luz">Luz</option></select></label></article>)}</div></div>{[['olivo','Olivo','01'],['mar','Mar','02'],['luz','Luz','03']].map(([id,name,n])=><section class="guest-table" data-table={id} aria-label={`Mesa ${name}`}><header><span>MESA {n}</span><strong>{name}</strong><small><span data-table-count={id}>0</span>/4 sitios</small></header><div data-table-guests={id}></div></section>)}</div><p class="ex-note">Nombres ficticios. El plano no se envía ni se guarda al cerrar o recargar la página.</p></section>
<section class="ex-section wedding-details"><span class="ex-label">EL HILO QUE LO UNE TODO</span><h2>Las decisiones pequeñas<br/>hacen una <em>gran diferencia.</em></h2><div class="ex-three"><article><h3>Una mesa con intención.</h3><p>Iluminación cálida, materiales que encajan y detalles que acompañan la conversación.</p></article><article><h3>Una celebración cómoda.</h3><p>Preguntar por necesidades de acceso, comidas y desplazamientos forma parte del cuidado.</p></article><article><h3>Una atmósfera propia.</h3><p>Elegir lo que os representa, en lugar de sumar detalles solo porque alguien dice que hay que hacerlo.</p></article></div></section>
<End name="nudo" title="Contadnos cómo os lo imagináis." choices={['Organización desde cero','Ayuda con los últimos detalles','Coordinación del día']} questions={[["¿Trabajáis con un único estilo?","La propuesta del estudio empieza escuchando. La identidad de cada celebración se construye alrededor de las personas y del lugar."],["¿El plano de mesas se puede usar con teclado?","Sí. Cada invitado tiene un selector con las tres mesas y la zona por colocar. Las mismas reglas de capacidad se aplican al arrastre y al selector."],["¿Se guarda el plano que preparo?","El plano vive únicamente en esta sesión de la página y se reinicia al recargar. Es una herramienta de demostración, no un servicio de planificación contratado."]]}/>
